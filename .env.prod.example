# =========================================================
# PWA App - variables para docker-compose.prod.yml
# Copia este archivo como .env.prod y completa los valores reales.
# NUNCA reutilices los valores del .env.example de desarrollo.
# Los secretos de backend van en backend/.env.prod (ver su ejemplo).
# =========================================================

# Postgres (deben coincidir con backend/.env.prod DB_USER/DB_PASSWORD/DB_NAME)
POSTGRES_USER=pwa_user
POSTGRES_PASSWORD=openssl_rand_-base64_48
POSTGRES_DB=pwa_db

# Secreto compartido backend/Kong (debe coincidir con backend/.env.prod JWT_ACCESS_SECRET)
# Genera uno con: openssl rand -base64 48
JWT_ACCESS_SECRET=openssl_rand_-base64_48

# Origenes permitidos por CORS en Kong: same-origin vía reverse proxy del host.
# ej. ["https://tu-dominio.com"]
KONG_CORS_ORIGINS=["https://tu-dominio.com"]

# Redis (debe coincidir con backend/.env.prod REDIS_PASSWORD)
# Genera uno con: openssl rand -base64 32
REDIS_PASSWORD=openssl_rand_-base64_32

# API key para GET /api/metrics (Prometheus) a través de Kong (key-auth).
# Genera uno con: openssl rand -base64 32
KONG_METRICS_API_KEY=openssl_rand_-base64_32