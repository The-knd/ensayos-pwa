# =========================================================
# backend/.env.prod — variables para docker-compose.prod.yml
# Copia como backend/.env.prod y completa con valores reales.
# NUNCA reutilices los valores de dev/.env.example.
# =========================================================

NODE_ENV=production
PORT=3000

# El host de Postgres en docker-compose.prod.yml es el nombre del servicio.
DB_HOST=postgres
DB_PORT=5432
DB_USER=pwa_user
# Debe coincidir con POSTGRES_PASSWORD del .env raíz usado por `docker compose -f docker-compose.prod.yml`
DB_PASSWORD=
DB_NAME=pwa_db

REDIS_HOST=redis
REDIS_PORT=6379
# Debe coincidir con REDIS_PASSWORD del .env raíz. Genera con: openssl rand -base64 32
REDIS_PASSWORD=

# Genera con: openssl rand -base64 48 — debe coincidir con JWT_ACCESS_SECRET del .env raíz (lo usa Kong también)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

WEBAUTHN_RP_ID=tu-dominio.com
WEBAUTHN_RP_NAME=PWA App
WEBAUTHN_ORIGIN=https://tu-dominio.com

# Kong es la única capa CORS en producción; el tráfico le llega same-origin
# vía el reverse proxy del host (no hay requests cross-origin desde el browser).
ENABLE_NESTJS_CORS=false

# Nunca en producción: evita crear usuarios/clientes demo con password conocida.
SEED_DEMO_DATA=false
# Password de los usuarios demo (solo dev). Mantener fuera de producción.
SEED_DEMO_PASSWORD=

# Rol de aplicación NO owner (RLS realmente activo). Si lo activas:
#  - Genera una password fuerte (openssl rand -base64 32)
#  - La migración 1700000015000-RlsHardening crea el rol y aplica FORCE RLS;
#    las migraciones nuevas se ejecutan con DB_USER (owner).
DB_APP_USER=app_runtime
DB_APP_PASSWORD=
