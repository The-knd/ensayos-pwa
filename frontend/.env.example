# =========================================================
# Frontend PWA App
# =========================================================

# URL base de la API (same-origin por defecto).
# En desarrollo Vite proxya /api hacia el backend; en producción lo hace nginx.
VITE_API_URL=/api

# Destino del proxy de desarrollo de Vite (solo aplica a `npm run dev`).
# Apunta a Kong (no al backend directo) para que JWT/CORS/rate-limit se
# comporten igual que en producción. Requiere `docker compose up postgres
# redis kong` si corres frontend/backend nativos fuera de Docker.
# Dentro de docker-compose se sobreescribe con http://kong:8000.
VITE_PROXY_TARGET=http://localhost:8000