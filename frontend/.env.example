# =========================================================
# Frontend PWA App
# =========================================================

# URL base de la API (same-origin por defecto).
# En desarrollo Vite proxya /api hacia el backend; en producción lo hace nginx.
VITE_API_URL=/api

# Destino del proxy de desarrollo de Vite (solo aplica a `npm run dev`).
# Dentro de docker-compose se sobreescribe con http://backend:3000.
VITE_PROXY_TARGET=http://localhost:3000