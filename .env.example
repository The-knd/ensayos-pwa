# =========================================================
# PWA App - variables de entorno para docker-compose
# Copia este archivo como .env y completa los valores reales.
# =========================================================

# Postgres (deben coincidir con backend/.env DB_USER/DB_PASSWORD/DB_NAME)
POSTGRES_USER=pwa_user
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=pwa_db

# Secreto compartido backend/Kong (debe coincidir con backend/.env JWT_ACCESS_SECRET)
# Genera uno con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambia_este_secreto

# Origenes permitidos por CORS en Kong (formato lista JSON).
# Dev (docker-compose.yml): http://localhost:5173
# Prod (same-origin vía reverse proxy del host): ["https://tu-dominio.com"]
KONG_CORS_ORIGINS=["http://localhost:5173"]

# Redis (debe coincidir con backend/.env REDIS_PASSWORD)
# Genera uno con: openssl rand -base64 32
REDIS_PASSWORD=cambia_este_password